# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# Настройки базы данных
DB_PATH=bot_database.db

# Настройки логирования
LOG_LEVEL=INFO
LOG_FILE=bot.log

# Режим работы
DEBUG=False

# Настройки уведомлений (по умолчанию)
DEFAULT_NOTIFY_DELETED=1
DEFAULT_NOTIFY_EDITED=1
DEFAULT_SAVE_MEDIA=1
DEFAULT_AUTO_FORWARD=0

# Лимиты
MAX_HISTORY_MESSAGES=1000
MAX_TEXT_LENGTH=4096

# Настройки бота
BOT_NAME=BusinessTrackerBot
BOT_DESCRIPTION=Сохраняет удаленные и измененные сообщения через Business API